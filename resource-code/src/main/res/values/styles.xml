<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/vixx_deep_black</item>
        <item name="android:navigationBarColor">@color/vixx_deep_black</item>
        <item name="android:scrollbarThumbHorizontal">@color/vixx_neon_purple</item>
        <item name="android:scrollbarThumbVertical">@color/vixx_neon_purple</item>
        <item name="android:textSize">@dimen/_12ssp</item>
    </style>

    <style name="VixxLauncherTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/vixx_deep_black</item>
    </style>

    <style name="CustomDialogStyle" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:scrollbarThumbHorizontal">@color/vixx_neon_purple</item>
        <item name="android:scrollbarThumbVertical">@color/vixx_neon_purple</item>
    </style>

    <style name="CustomAlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:scrollbarThumbHorizontal">@color/vixx_neon_purple</item>
        <item name="android:scrollbarThumbVertical">@color/vixx_neon_purple</item>
    </style>

    <style name="RoundedCornersImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4%</item>
    </style>

    <style name="RoundImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="VixxButton" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">@color/vixx_neon_purple</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="VixxButton.Primary">
        <item name="android:backgroundTint">@color/vixx_neon_purple</item>
    </style>

    <style name="VixxButton.Secondary">
        <item name="android:backgroundTint">@color/vixx_dark_purple</item>
    </style>

    <style name="VixxSidebarItem">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">@dimen/_8sdp</item>
        <item name="android:paddingEnd">@dimen/_6sdp</item>
    </style>

    <style name="VixxSidebarIcon">
        <item name="android:layout_width">@dimen/_20sdp</item>
        <item name="android:layout_height">@dimen/_20sdp</item>
        <item name="android:layout_alignParentStart">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:layout_marginStart">@dimen/_3sdp</item>
        <item name="android:tint">@color/vixx_neon_purple_light</item>
    </style>

    <style name="VixxSidebarText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:layout_marginStart">@dimen/_29sdp</item>
        <item name="android:textColor">@color/vixx_silver</item>
        <item name="android:textSize">@dimen/_10ssp</item>
    </style>

</resources>
