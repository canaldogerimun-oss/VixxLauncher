<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vixx_performance_background"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/skinEditorBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/vixx_ds_button_secondary"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/vixx_white_secondary"
                android:textSize="30sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EDITOR DE SKIN"
                    android:textColor="@color/vixx_white_secondary"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pintura pixel a pixel • 64 × 64"
                    android:textColor="@color/vixx_silver"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/skinEditorSave"
                android:layout_width="78dp"
                android:layout_height="42dp"
                android:background="@drawable/vixx_ds_button_primary"
                android:gravity="center"
                android:text="Salvar"
                android:textColor="@color/vixx_white_secondary"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="TEXTURA COMPLETA"
            android:textColor="@color/vixx_neon_purple_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.movtery.zalithlauncher.ui.view.SkinPixelEditorView
            android:id="@+id/skinPixelEditor"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/vixx_ds_surface_card"
            android:contentDescription="Editor de textura de skin Minecraft 64 por 64" />

        <TextView
            android:id="@+id/skinEditorColorLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Cor selecionada"
            android:textColor="@color/vixx_white_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/skinEditorPalette"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/skinEditorMoreColors"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/vixx_ds_button_secondary"
            android:gravity="center"
            android:text="Abrir paleta completa"
            android:textColor="@color/vixx_white_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="FERRAMENTAS"
            android:textColor="@color/vixx_neon_purple_light"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/skinEditorPencil"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/vixx_ds_button_secondary"
                android:gravity="center"
                android:text="✎ Lápis"
                android:textColor="@color/vixx_white_secondary" />

            <TextView
                android:id="@+id/skinEditorEraser"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/vixx_ds_button_secondary"
                android:gravity="center"
                android:text="⌫ Borracha"
                android:textColor="@color/vixx_white_secondary" />

            <TextView
                android:id="@+id/skinEditorUndo"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/vixx_ds_button_secondary"
                android:gravity="center"
                android:text="↶"
                android:textColor="@color/vixx_white_secondary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/skinEditorRedo"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/vixx_ds_button_secondary"
                android:gravity="center"
                android:text="↷"
                android:textColor="@color/vixx_white_secondary"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="12dp"
            android:background="@drawable/vixx_ds_surface_card"
            android:text="Dica: amplie a textura com os dedos e pinte diretamente os pixels. O quadriculado representa transparência. Use desfazer e refazer para corrigir alterações."
            android:textColor="@color/vixx_silver"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
