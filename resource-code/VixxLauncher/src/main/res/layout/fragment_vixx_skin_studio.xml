<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vixx_performance_background"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VIXX SKIN STUDIO"
            android:textColor="@color/vixx_white_secondary"
            android:textSize="23sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sua coleção de skins Minecraft Java"
            android:textColor="@color/vixx_silver"
            android:textSize="12sp" />

        <com.movtery.zalithlauncher.ui.view.Skin3DPreviewView
            android:id="@+id/skin3dPreview"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/viewFront" style="@style/VixxSkinViewChip" android:text="Frente" />
                <TextView android:id="@+id/viewBack" style="@style/VixxSkinViewChip" android:text="Costas" />
                <TextView android:id="@+id/viewLeft" style="@style/VixxSkinViewChip" android:text="Esquerda" />
                <TextView android:id="@+id/viewRight" style="@style/VixxSkinViewChip" android:text="Direita" />
                <TextView android:id="@+id/viewTop" style="@style/VixxSkinViewChip" android:text="Topo" />
                <TextView android:id="@+id/viewFree" style="@style/VixxSkinViewChip" android:text="Livre 3D" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/toggleOuterLayer"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/vixx_ds_button_secondary"
            android:gravity="center"
            android:text="Camada externa: visível"
            android:textColor="@color/vixx_white_secondary" />

        <TextView
            android:id="@+id/skinName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nenhuma skin selecionada"
            android:textColor="@color/vixx_white_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/skinModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Modelo: Classic"
            android:textColor="@color/vixx_silver"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/importSkinButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/vixx_ds_button_primary"
                android:gravity="center"
                android:text="＋ Importar PNG"
                android:textColor="@color/vixx_white_secondary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/exportSkinButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/vixx_ds_button_secondary"
                android:gravity="center"
                android:text="Exportar PNG"
                android:textColor="@color/vixx_white_secondary"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/modelClassicButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/vixx_ds_button_secondary"
                android:gravity="center"
                android:text="Steve • Classic"
                android:textColor="@color/vixx_white_secondary" />

            <TextView
                android:id="@+id/modelSlimButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/vixx_ds_button_secondary"
                android:gravity="center"
                android:text="Alex • Slim"
                android:textColor="@color/vixx_white_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/openSkinEditorButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/vixx_ds_button_secondary"
            android:gravity="center"
            android:text="✎  Abrir editor avançado"
            android:textColor="@color/vixx_white_secondary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/skinStudioHelpButton"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/vixx_ds_button_secondary"
            android:gravity="center"
            android:text="Como funciona o Skin Studio?"
            android:textColor="@color/vixx_white_secondary" />

        <TextView
            android:id="@+id/applySkinButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/vixx_ds_button_primary"
            android:gravity="center"
            android:text="Aplicar na conta Minecraft"
            android:textColor="@color/vixx_white_secondary"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="MINHA COLEÇÃO"
            android:textColor="@color/vixx_neon_purple_light"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/collectionEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Importe uma skin PNG para começar sua coleção."
            android:textColor="@color/vixx_silver"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/skinCollection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="@drawable/vixx_ds_surface_card"
            android:text="Dica: arraste o personagem para girar e use dois dedos para aproximar. As skins padrão ficam disponíveis offline. A publicação no perfil depende do provedor de autenticação; contas locais/offline não possuem perfil remoto para receber upload. Em servidores, a exibição também depende do suporte a skins do próprio servidor."
            android:textColor="@color/vixx_silver"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
