                    android:layout_height="@dimen/_43sdp"
                    android:src="@drawable/ic_minecraft"
                    android:scaleType="fitCenter" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/_9sdp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/selectedVersionName" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Nenhuma versão" android:textColor="@color/vixx_white_secondary" android:textSize="@dimen/_12ssp" android:textStyle="bold" />
                    <TextView android:id="@+id/selectedVersionInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Selecione uma instalação" android:textColor="@color/vixx_neon_purple_light" android:textSize="@dimen/_9ssp" />
                </LinearLayout>
                <ImageButton
                    android:id="@+id/managerProfileButton"
